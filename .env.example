# Copy this file to `.env` and pick ONE database setup.

# ─────────────────────────────────────────────────────────────────────────────
# Option A — SQLite (no server to install; ideal for Windows / a fresh laptop).
# The repo ships a ready-built prisma/customs.db, so you can just run the app.
# ─────────────────────────────────────────────────────────────────────────────
DB_PROVIDER="sqlite"
DATABASE_URL="file:./customs.db"

# ─────────────────────────────────────────────────────────────────────────────
# Option B — Postgres (server-based; enables tsvector full-text search).
# Uncomment these two and comment out the SQLite pair above.
#   - Docker:      DATABASE_URL="postgresql://postgres:postgres@localhost:5432/customs"
#   - Local socket:DATABASE_URL="postgresql://USER@localhost:5432/customs?host=/var/run/postgresql"
#   - Neon (cloud):DATABASE_URL="postgresql://USER:PASSWORD@HOST/customs?sslmode=require"
# ─────────────────────────────────────────────────────────────────────────────
# DB_PROVIDER="postgres"
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/customs"
